# Copy this file to .env and fill in real values. .env is ignored by git.

# PostgreSQL. `make migrate` creates the database if it is missing.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=central_logs
DB_USERNAME=central_logs
DB_PASSWORD=change-me

# HTTP server. Default: 127.0.0.1:8080
# CENTRAL_LOGS_ADDR=127.0.0.1:8080

# Login (OAuth 2.0 authorization code flow with the identity service).
# Optional: identity service base URL. Default: https://backend.nvnhan0810.com
# CENTRAL_LOGS_IDENTITY_URL=https://backend.nvnhan0810.com
# Optional: client registered with the identity service. Default: central-logs
# CENTRAL_LOGS_IDENTITY_CLIENT_ID=central-logs
# Required: public origin of this backend, scheme://host[:port] with no path. The login callback is
# <this origin>/api/auth/callback, which must be registered with the identity service as a redirect URI.
CENTRAL_LOGS_BACKEND_URL=http://localhost:8080

# Encrypts refresh tokens in the database. Required. Generate with: openssl rand -base64 32
# Changing it signs every user out.
CENTRAL_LOGS_SESSION_KEY=

# The frontend origin: where the browser is sent after login, and the only origin allowed to call
# the API from the browser (CORS). Format: scheme://host[:port], no path. Default: http://localhost:3000
# CENTRAL_LOGS_FRONTEND_URL=http://localhost:3000
# Set to false only for plain-HTTP local development. Default: true
# CENTRAL_LOGS_COOKIE_SECURE=true
