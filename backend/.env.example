# Copy this file to .env and fill in real values. .env is ignored by git.

# PostgreSQL. `make migrate` creates the database if it is missing.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=central_logs
DB_USERNAME=central_logs
DB_PASSWORD=change-me

# HTTP server. Default: 127.0.0.1:8080
# CENTRAL_LOGS_ADDR=127.0.0.1:8080

# Login (OpenID Connect). CLIENT_ID and REDIRECT_URI are required.
CENTRAL_LOGS_OIDC_CLIENT_ID=
CENTRAL_LOGS_OIDC_REDIRECT_URI=http://localhost:8080/api/auth/callback
# Only for confidential clients; PKCE is always used.
# CENTRAL_LOGS_OIDC_CLIENT_SECRET=
# CENTRAL_LOGS_OIDC_ISSUER=https://identity.nvnhan0810.com

# Where the browser is sent after login. Default: http://localhost:3000
# CENTRAL_LOGS_FRONTEND_URL=http://localhost:3000
# Set to false only for plain-HTTP local development. Default: true
# CENTRAL_LOGS_COOKIE_SECURE=true

# Frontend origins allowed to call the API from the browser (CORS), comma-separated.
# Each is scheme://host[:port], no path. Default: http://localhost:5173
# CENTRAL_LOGS_CORS_ORIGINS=http://localhost:5173
