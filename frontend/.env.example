# Copy this file to .env (or .env.production) and adjust the values.
# Vite only exposes variables prefixed with VITE_ to the client code.
# These values are embedded at build time: run `npm run build` again after changing them.

# Backend API base URL. Must be same-site with the frontend,
# because the backend session cookie is SameSite=Lax.
# Default when unset: http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
